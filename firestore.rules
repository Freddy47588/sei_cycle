rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && hasProfile()
        && currentUser().data.get('isActive', true) != false
        && currentUser().data.get('is_active', true) != false;
    }

    function canViewAppData() {
      return activeUser();
    }

    function profileRole() {
      return activeUser() ? currentUser().data.role : null;
    }

    function effectiveProfileRole() {
      return isAdmin()
        ? 'admin'
        : isOperatorLapangan()
          ? 'operator_lapangan'
          : isOperatorKeuangan()
            ? 'operator_keuangan'
            : profileRole();
    }

    function hasRole(role) {
      return activeUser() && profileRole() == role;
    }

    function hasAnyRole(roles) {
      return activeUser() && profileRole() in roles;
    }

    /*
      Role utama branch backend:
      - admin
      - operator_lapangan
      - operator_keuangan

      Legacy dibaca agar data lama tidak langsung rusak:
      - operator
      - mitra
      - peserta_edukasi
    */

    function isAdmin() {
      return hasAnyRole([
        'admin',
        'Admin',
        'ADMIN',
        ' admin',
        'admin ',
        ' admin '
      ]);
    }

    function isOperatorLapangan() {
      return hasAnyRole([
        'operator_lapangan',
        'operator'
      ]);
    }

    function isOperatorKeuangan() {
      return hasRole('operator_keuangan');
    }

    function isRoleTarget(role) {
      return role == 'all' || supportedRole(role);
    }

    function canManageOperations() {
      return activeUser() && currentUser().data.role in ['admin', 'Admin', 'ADMIN', ' admin', 'admin ', ' admin ', 'operator_lapangan', 'operator'];
    }

    function canManageFinance() {
      return isAdmin() || isOperatorKeuangan();
    }

    function supportedRole(role) {
      return role in [
        'admin',
        'operator_lapangan',
        'operator_keuangan',
        'operator',
        'mitra',
        'peserta_edukasi'
      ];
    }

    function createsOwnDocument(documentId) {
      return request.resource.data.id == documentId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.isDeleted == false;
    }

    function updatesExistingDocument() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validFinanceTransaction(documentId, data) {
      return data.keys().hasOnly([
          'id',
          'type',
          'category',
          'amount',
          'date',
          'description',
          'notes',
          'paymentMethod',
          'moduleType',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy',
          'isDeleted',
          'isSampleData',
          'sampleVersion'
        ])
        && data.id == documentId
        && data.type in ['income', 'expense']
        && data.category is string
        && data.category.size() > 0
        && data.amount is number
        && data.amount > 0
        && data.date is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.updatedBy is string
        && data.isDeleted is bool
        && (!('isSampleData' in data.keys()) || data.isSampleData is bool)
        && (!('sampleVersion' in data.keys()) || data.sampleVersion is string)
        && (!('description' in data.keys()) || data.description is string)
        && (!('notes' in data.keys()) || data.notes is string)
        && (!('paymentMethod' in data.keys()) || data.paymentMethod is string)
        && (!('moduleType' in data.keys()) || data.moduleType is string);
    }

    function userCanUpdateOwnProfile(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.id == uid

        // user biasa tidak boleh mengubah role dan status aktif
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive

        // field profil ringan yang boleh diubah sendiri
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'uid',
          'name',
          'email',
          'photoUrl',
          'fcmToken',
          'fcmTokenUpdatedAt',
          'updatedAt'
        ]);
    }

    function canReadNotification(data) {
      return activeUser() && (
        isAdmin()
        || data.userId == request.auth.uid
        || data.targetRole == 'all'
        || data.targetRole == effectiveProfileRole()
      );
    }

    function validNotificationBase(documentId, data) {
      return data.keys().hasOnly([
          'id',
          'title',
          'body',
          'type',
          'targetRole',
          'userId',
          'relatedCollection',
          'relatedId',
          'isRead',
          'readAt',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy',
          'scheduledAt',
          'isDeleted',
          'isSampleData',
          'sampleVersion'
        ])
        && data.id == documentId
        && data.title is string
        && data.title.size() > 0
        && data.body is string
        && data.body.size() > 0
        && data.type in [
          'low_stock',
          'schedule_overdue',
          'production_reminder',
          'system'
        ]
        && data.targetRole is string
        && isRoleTarget(data.targetRole)
        && data.userId is string
        && data.isRead is bool
        && data.isRead == false
        && data.createdAt is timestamp
        && data.isDeleted is bool
        && data.isDeleted == false
        && (!('updatedAt' in data.keys()) || data.updatedAt is timestamp)
        && (!('createdBy' in data.keys()) || data.createdBy is string)
        && (!('updatedBy' in data.keys()) || data.updatedBy is string)
        && (!('isSampleData' in data.keys()) || data.isSampleData is bool)
        && (!('sampleVersion' in data.keys()) || data.sampleVersion is string)
        && (!('relatedCollection' in data.keys()) || data.relatedCollection is string)
        && (!('relatedId' in data.keys()) || data.relatedId is string)
        && (!('scheduledAt' in data.keys()) || data.scheduledAt is timestamp);
    }

    function userCanCreateOwnNotification(documentId) {
      return activeUser()
        && validNotificationBase(documentId, request.resource.data)
        && request.resource.data.type in [
          'low_stock',
          'schedule_overdue',
          'production_reminder'
        ]
        && request.resource.data.userId == request.auth.uid
        && isRoleTarget(request.resource.data.targetRole);
    }

    function userCanRefreshOwnNotification() {
      return activeUser()
        && validNotificationBase(resource.data.id, request.resource.data)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isRoleTarget(request.resource.data.targetRole)
        && request.resource.data.type == resource.data.type
        && request.resource.data.type in [
          'low_stock',
          'schedule_overdue',
          'production_reminder'
        ];
    }

    function adminCanCreateSystemNotification(documentId) {
      return isAdmin()
        && validNotificationBase(documentId, request.resource.data)
        && request.resource.data.type == 'system';
    }

    /*
      USERS
      Semua user login bisa baca profil untuk tampilan/role app.
      User biasa hanya bisa buat dan edit profil sendiri.
      Admin bisa tambah/edit/hapus semua user.
    */
    match /users/{uid} {
      allow create: if (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.id == uid

        // default sesuai rules branch backend yang kamu kirim
        && request.resource.data.role == 'operator_lapangan'
        && request.resource.data.isActive == true
      ) || (
        isAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.id == uid
        && supportedRole(request.resource.data.role)
      );

      allow read: if signedIn();

      allow update: if (
        isAdmin()
        && supportedRole(request.resource.data.role)
      ) || userCanUpdateOwnProfile(uid);

      allow delete: if isAdmin();
    }

    /*
      MASTER MODUL KEBUN
      Semua user login bisa lihat.
      Hanya admin yang boleh kelola.
    */
    match /farm_modules/{moduleId} {
      allow read: if canViewAppData();
      allow create, update, delete: if isAdmin();
    }

    // Phase 03: deterministic code/document ID makes uniqueness atomic.
    function validBatch(id, d) {
      return d.keys().hasAll(['id', 'name', 'code', 'moduleType', 'locationName',
          'status', 'startedAt', 'expectedHarvestAt', 'completedAt', 'initialQuantity',
          'initialUnit', 'commodity', 'notes', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt', 'isDeleted'])
        && d.keys().hasOnly(['id', 'name', 'code', 'moduleType', 'locationName',
          'status', 'startedAt', 'expectedHarvestAt', 'completedAt', 'initialQuantity',
          'initialUnit', 'commodity', 'notes', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt', 'isDeleted'])
        && d.id == id && d.code == id
        && d.code is string && d.code.matches('^[A-Z0-9][A-Z0-9_-]{2,39}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120 && d.name.matches('.*[^ \\t\\r\\n].*')
        && d.locationName is string && d.locationName.size() > 0 && d.locationName.size() <= 120 && d.locationName.matches('.*[^ \\t\\r\\n].*')
        && d.moduleType in ['ayam_kampung', 'maggot_bsf', 'cacing_tanah', 'tanaman', 'lele']
        && d.status in ['planned', 'active', 'completed', 'archived']
        && d.startedAt is timestamp
        && (d.expectedHarvestAt == null || (d.expectedHarvestAt is timestamp && d.expectedHarvestAt >= d.startedAt))
        && ((d.status in ['planned', 'active'] && d.completedAt == null)
          || (d.status in ['completed', 'archived'] && d.completedAt is timestamp))
        && d.initialUnit is string && d.initialUnit.size() <= 30
        && (d.initialQuantity == null || (d.initialQuantity is number && d.initialQuantity >= 0
          && d.initialQuantity <= 1000000000000000 && d.initialUnit.size() > 0 && d.initialUnit.matches('.*[^ \\t\\r\\n].*')))
        && d.commodity is string && d.commodity.size() <= 120
        && d.notes is string && d.notes.size() <= 3000
        && d.createdBy is string && d.updatedBy is string
        && d.createdAt is timestamp && d.updatedAt is timestamp && d.isDeleted == false;
    }
    function validBatchTransition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'updatedBy', 'updatedAt'])
        && ((resource.data.status == 'planned' && request.resource.data.status == 'active')
          || (resource.data.status == 'active' && request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time)
          || (resource.data.status == 'completed' && request.resource.data.status == 'archived'
            && request.resource.data.completedAt == resource.data.completedAt));
    }
    match /batches/{batchId} {
      allow read: if canViewAppData();
      allow create: if canManageOperations() && validBatch(batchId, request.resource.data)
        && createsOwnDocument(batchId) && request.resource.data.status == 'planned'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageOperations() && validBatch(batchId, request.resource.data)
        && updatesExistingDocument() && request.resource.data.updatedAt == request.time
        && (validBatchTransition() || (
          resource.data.status in ['planned', 'active']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'locationName', 'expectedHarvestAt', 'commodity', 'notes', 'updatedBy', 'updatedAt'])));
      allow delete: if false;
    }
    function validLogbookBatch(d) {
      return !('batchId' in d) || (d.batchId is string && d.batchId.size() > 0
        && existsAfter(/databases/$(database)/documents/batches/$(d.batchId))
        && getAfter(/databases/$(database)/documents/batches/$(d.batchId)).data.isDeleted == false
        && getAfter(/databases/$(database)/documents/batches/$(d.batchId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/batches/$(d.batchId)).data.moduleType == d.moduleType);
    }

    /*
      LOGBOOK OPERASIONAL
      Semua user login bisa lihat tampilan.
      Admin/operator lapangan bisa tambah dan edit notes dengan audit atomik.
      Koreksi kuantitas dan pembatalan belum diaktifkan pada Phase 02.
    */
    match /logbooks/{logbookId} {
      allow read: if canViewAppData();

      allow create: if canManageOperations()
        && validLogbookBatch(request.resource.data)
        && createsOwnDocument(logbookId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canManageOperations()
        && updatesExistingDocument()
        && resource.data.isDeleted == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'notes', 'updatedBy', 'updatedAt', 'lastNoteEditId'
        ])
        && request.resource.data.notes is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastNoteEditId is string
        && !exists(/databases/$(database)/documents/logbooks/$(logbookId)/note_edits/$(request.resource.data.lastNoteEditId))
        && getAfter(/databases/$(database)/documents/logbooks/$(logbookId)/note_edits/$(request.resource.data.lastNoteEditId)).data.before == resource.data.notes
        && getAfter(/databases/$(database)/documents/logbooks/$(logbookId)/note_edits/$(request.resource.data.lastNoteEditId)).data.after == request.resource.data.notes;

      allow delete: if false;

      match /note_edits/{editId} {
        allow read: if canViewAppData();
        allow create: if canManageOperations()
          && request.resource.data.keys().hasOnly(['before', 'after', 'editedBy', 'editedAt'])
          && request.resource.data.before is string
          && request.resource.data.after is string
          && request.resource.data.editedBy == request.auth.uid
          && request.resource.data.editedAt == request.time
          && getAfter(/databases/$(database)/documents/logbooks/$(logbookId)).data.lastNoteEditId == editId
          && getAfter(/databases/$(database)/documents/logbooks/$(logbookId)).data.notes == request.resource.data.after
          && getAfter(/databases/$(database)/documents/logbooks/$(logbookId)).data.updatedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    /*
      INVENTORY
      Collection branch backend: inventory
      Bukan inventory_items.
    */
    // Phase 04: no stock change (including admin) without a new paired ledger.
    function canReadOperations() {
      return activeUser() && (supportedRole(currentUser().data.role) || isAdmin());
    }
    function finiteStock(n) {
      return n is number && n >= -1000000000000000 && n <= 1000000000000000;
    }
    function validInventory(id, d) {
      return d.id == id && d.name is string && d.name.size() > 0
        && d.itemKey is string && d.itemKey.size() > 0
        && d.moduleType in ['', 'ayam_kampung', 'maggot_bsf', 'cacing_tanah', 'tanaman', 'lele']
        && d.category is string && d.category.size() > 0
        && d.unit is string && d.unit.size() > 0
        && finiteStock(d.currentStock) && finiteStock(d.minStock) && d.minStock >= 0
        && d.isLowStock == (d.currentStock <= d.minStock)
        && d.isDeleted is bool && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function pairedStock(id, d, before) {
      let t = getAfter(/databases/$(database)/documents/inventory_transactions/$(d.lastTransactionId)).data;
      return d.lastTransactionId is string
        && !exists(/databases/$(database)/documents/inventory_transactions/$(d.lastTransactionId))
        && t.itemId == id && t.beforeStock == before && t.afterStock == d.currentStock
        && t.createdBy == request.auth.uid && t.createdAt == request.time;
    }
    match /inventory/{itemId} {
      allow read: if canReadOperations();
      allow create: if canManageOperations() && validInventory(itemId, request.resource.data)
        && createsOwnDocument(itemId) && request.resource.data.createdAt == request.time
        && ((request.resource.data.currentStock == 0 && !('lastTransactionId' in request.resource.data))
          || pairedStock(itemId, request.resource.data, 0));
      allow update: if canManageOperations() && validInventory(itemId, request.resource.data)
        && updatesExistingDocument() && resource.data.isDeleted == false
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'category', 'location', 'minStock', 'isLowStock', 'updatedBy', 'updatedAt'])
            && request.resource.data.isDeleted == false)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentStock', 'lastTransactionId', 'isLowStock', 'updatedBy', 'updatedAt'])
            && pairedStock(itemId, request.resource.data, resource.data.currentStock))
          || (isAdmin() && resource.data.currentStock == 0 && request.resource.data.isDeleted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'updatedBy', 'updatedAt']))
        );
      allow delete: if false;
    }
    function validLedgerSource(d, item) {
      return (d.source == 'manual' && d.requestId == d.id
          && d.type in ['in', 'out', 'correction'] && d.notes.size() > 0
          && d.moduleType == item.moduleType && !('logbookId' in d)
          && d.allowNegative is bool && finiteStock(d.requestedValue) && d.requestedValue >= 0
          && (d.afterStock >= 0 || d.allowNegative == true)
          && ((d.type == 'correction' && d.afterStock == d.requestedValue)
            || (d.type != 'correction' && d.quantity == d.requestedValue))
          && (!('batchId' in d) || d.batchId == null || validLogbookBatch(d)))
        || (d.source == 'opening' && d.type == 'opening' && d.beforeStock == 0
          && d.afterStock > 0 && d.requestId == d.itemId && d.id == 'opening_' + d.itemId
          && !exists(/databases/$(database)/documents/inventory/$(d.itemId))
          && d.moduleType == item.moduleType && !('logbookId' in d) && !('batchId' in d))
        || (d.source == 'logbook' && d.moduleType in ['ayam_kampung', 'maggot_bsf', 'cacing_tanah', 'tanaman', 'lele'] && d.type in ['in', 'out'] && d.requestId == d.logbookId
          && !exists(/databases/$(database)/documents/logbooks/$(d.logbookId))
          && getAfter(/databases/$(database)/documents/logbooks/$(d.logbookId)).data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/logbooks/$(d.logbookId)).data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/logbooks/$(d.logbookId)).data.moduleType == d.moduleType
          && d.get('batchId', null) == getAfter(/databases/$(database)/documents/logbooks/$(d.logbookId)).data.get('batchId', null));
    }
    function validLedger(id, d) {
      let item = getAfter(/databases/$(database)/documents/inventory/$(d.itemId)).data;
      let before = exists(/databases/$(database)/documents/inventory/$(d.itemId))
        ? get(/databases/$(database)/documents/inventory/$(d.itemId)).data.currentStock : 0;
      return d.keys().hasOnly(['id', 'requestId', 'itemId', 'itemName', 'itemKey', 'moduleType',
          'type', 'quantity', 'unit', 'beforeStock', 'afterStock', 'notes', 'transactionDate',
          'createdBy', 'createdAt', 'batchId', 'logbookId', 'source', 'isReversed',
          'reversedAt', 'reversedBy', 'allowNegative', 'requestedValue'])
        && d.id == id && d.createdBy == request.auth.uid
        && d.createdAt == request.time && d.transactionDate == request.time
        && d.itemName == item.name && d.itemKey == item.itemKey && d.unit == item.unit
        && d.notes is string && d.isReversed == false
        && d.get('reversedAt', null) == null && d.get('reversedBy', '') == ''
        && finiteStock(d.quantity) && d.quantity >= 0
        && finiteStock(d.beforeStock) && finiteStock(d.afterStock)
        && d.beforeStock == before && d.afterStock == item.currentStock
        && item.isDeleted == false && item.lastTransactionId == id && item.updatedAt == request.time
        && ((d.type in ['in', 'opening'] && d.quantity > 0 && d.afterStock == d.beforeStock + d.quantity)
          || (d.type == 'out' && d.quantity > 0 && d.afterStock == d.beforeStock - d.quantity)
          || (d.type == 'correction' && d.quantity == math.abs(d.afterStock - d.beforeStock)))
        && validLedgerSource(d, item);
    }
    match /inventory_transactions/{transactionId} {
      allow read: if canReadOperations();
      allow create: if canManageOperations() && validLedger(transactionId, request.resource.data);
      allow update, delete: if false;
    }

    /*
      PRODUCTION RESULTS
      Hasil produksi/panen yang berasal dari logbook.
    */
    match /production_results/{resultId} {
      allow read: if canViewAppData();
      allow create: if isAdmin()
        || (
          canManageOperations()
          && request.resource.data.id == resultId
          && request.resource.data.createdBy == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    /*
      CIRCULAR FLOWS
      Data aliran nutrisi dashboard. Semua user aktif bisa baca,
      admin/operator lapangan bisa tambah data operasional.
    */
    match /circular_flows/{flowId} {
      allow read: if canViewAppData();
      allow create: if isAdmin()
        || (
          canManageOperations()
          && request.resource.data.id == flowId
        );
      allow update, delete: if isAdmin();
    }

    /*
      SCHEDULES / KALENDER OPERASIONAL
    */
    function validSchedule(id, d) {
      return d.id == id && d.title is string && d.title.size() > 0
        && d.moduleType in ['ayam_kampung', 'maggot_bsf', 'cacing_tanah', 'tanaman', 'lele']
        && d.type is string && d.type.size() > 0 && d.date is timestamp
        && d.notes is string && d.status in ['pending', 'done', 'skipped']
        && d.isDeleted is bool && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function validScheduleBatch(d) {
      return !('batchId' in d) || d.batchId == null || validLogbookBatch(d);
    }
    match /schedules/{scheduleId} {
      allow read: if canReadOperations();
      allow create: if canManageOperations() && createsOwnDocument(scheduleId)
        && validSchedule(scheduleId, request.resource.data) && validScheduleBatch(request.resource.data)
        && request.resource.data.keys().hasOnly(['id', 'title', 'moduleType', 'type', 'date',
          'status', 'notes', 'batchId', 'isDeleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'creationPayload'])
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if canManageOperations() && updatesExistingDocument()
        && resource.data.isDeleted == false && resource.data.status == 'pending'
        && validSchedule(scheduleId, request.resource.data)
        && (
          (request.resource.data.status == 'pending' && request.resource.data.isDeleted == false
            && validScheduleBatch(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'moduleType', 'type', 'date', 'notes', 'batchId', 'updatedBy', 'updatedAt']))
          || (request.resource.data.status == 'done'
            && request.resource.data.completedBy == request.auth.uid && request.resource.data.completedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'completedBy', 'completedAt', 'updatedBy', 'updatedAt']))
          || (request.resource.data.status == 'skipped'
            && request.resource.data.skippedBy == request.auth.uid && request.resource.data.skippedAt == request.time
            && request.resource.data.skipReason is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'skippedBy', 'skippedAt', 'skipReason', 'updatedBy', 'updatedAt']))
          || (isAdmin() && request.resource.data.isDeleted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'updatedBy', 'updatedAt']))
        );
      allow delete: if false;
    }

    /*
      EDUKASI
      Semua user login bisa lihat tampilan edukasi.
      Hanya admin yang bisa lihat dan kelola semua status.
    */
    match /education_contents/{contentId} {
      allow read: if canViewAppData();

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /*
      FINANCE
      Collection branch backend: finance_transactions
      Semua user login bisa lihat tampilan.
      Admin dan operator keuangan bisa tambah/edit/soft delete/delete.
      Operator lapangan hanya read-only lewat route yang tersedia.
    */
    match /finance_transactions/{transactionId} {
      allow read: if canViewAppData();

      allow create: if canManageFinance()
        && validFinanceTransaction(transactionId, request.resource.data)
        && (
          isAdmin()
          || createsOwnDocument(transactionId)
        );

      allow update: if canManageFinance()
        && updatesExistingDocument()
        && validFinanceTransaction(transactionId, request.resource.data);

      allow delete: if canManageFinance();
    }

    /*
      NOTIFICATIONS
      Semua user hanya baca notifikasi yang memang untuk dirinya/role-nya.
      Admin bisa baca dan hapus semua.
    */
    match /notifications/{notificationId} {
      allow read: if canViewAppData();

      allow create: if isAdmin()
        || userCanCreateOwnNotification(notificationId)
        || adminCanCreateSystemNotification(notificationId);

      allow update: if (
          canReadNotification(resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead',
            'readAt'
          ])
        ) || userCanRefreshOwnNotification();

      allow update: if canReadNotification(resource.data)
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDeleted',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.isDeleted == true
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAdmin();
    }

    /*
      REPORT METADATA
      Metadata laporan/export client.
      Admin dan operator keuangan boleh kelola.
    */
    match /report_metadata/{reportId} {
      allow read: if canViewAppData();

      allow create: if canManageFinance()
        && (
          isAdmin()
          || createsOwnDocument(reportId)
        );

      allow update: if isAdmin()
        || (
          canManageFinance()
          && updatesExistingDocument()
          && request.resource.data.isDeleted == resource.data.isDeleted
        );

      allow delete: if isAdmin();
    }

    /*
      RECOMMENDATIONS
      Hasil rule-based recommendation default dibuat on-demand di client.
      Collection ini disiapkan untuk snapshot rekomendasi manual/admin-side.
    */
    match /recommendations/{recommendationId} {
      allow read: if canViewAppData();
      allow create, update, delete: if isAdmin();
    }

    /*
      Collection lain ditutup.
      Jadi kalau ada typo nama collection, langsung ketahuan permission-denied.
    */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
